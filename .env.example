# Copy to `.env` (git-ignored) and fill in. Do NOT commit real keys.
# In production, set these as Vercel project env vars instead of a file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Hardware mock for the local frontend tool (real data comes from Supabase)
FRONTEND_MOCK=1

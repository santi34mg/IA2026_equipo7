TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Se rellena automáticamente al primer /start, o ponlo manualmente
TELEGRAM_CHAT_ID=
# Modelo de chat (opcional). Default: gemini-2.5-flash.
# gemini-2.0-flash quedó sin cuota gratuita; 2.5-flash y 2.5-flash-lite sí tienen.
GEMINI_MODEL=gemini-2.5-flash
# Reintentos ante 429 / rate limit (opcional)
GEMINI_MAX_RETRIES=3
GEMINI_MAX_RETRY_WAIT=30
